# Affari Member API. Server-side only — never expose with a NEXT_PUBLIC_ prefix.
# Leave AFFARI_TOKEN empty to run the app against the built-in sample member.
AFFARI_TOKEN=
AFFARI_BASE_URL=https://api.affariretail.id/beauty/
AFFARI_TIMEOUT_MS=12000

# `field` values /api/member is searched by, in order, when a member logs in.
# Confirm the real field name for phone number before going live.
AFFARI_LOGIN_FIELDS=kode,nohp

# Signs the session cookie. At least 32 characters. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Public origin, used for canonical URLs, sitemap.xml, robots.txt and Open Graph.
# Must be the real production domain or search engines index the wrong host.
NEXT_PUBLIC_SITE_URL=https://member.beautykendari.id

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to keep the
# analytics script off — nothing is loaded until this is set.
NEXT_PUBLIC_GA_ID=

# Cloudflare Web Analytics beacon token. Get it in the Cloudflare dashboard under
# Web Analytics → Add a site (the token inside the data-cf-beacon snippet). Leave
# empty to keep the beacon off. Privacy-first, no cookies, no consent banner needed.
NEXT_PUBLIC_CF_BEACON_TOKEN=
